# Porta HTTP do serviço
PORT=3000

# Supabase — sistema de credenciamento
# URL do projeto (mesma para os dois clientes abaixo)
SUPABASE_URL=

# Chave anon/public — usada apenas pelo lookup LEGADO opcional
# (participants.id -> name, extra_answers). Nunca a service role aqui.
SUPABASE_KEY=

# Service role — exigida para habilitar o motor DINÂMICO
# (consulta mínima participants.id/event_id + RPCs allowlisted).
# Nunca expor esta chave ao app, navegador ou resposta da API.
SUPABASE_SERVICE_ROLE_KEY=

# Tabela e schema usados no lookup legado (mantém default se não tiver certeza)
SUPABASE_PARTICIPANTS_TABLE=participants
SUPABASE_SCHEMA=public

# --- Motor dinâmico de etiquetas (Fase 3) ---

# Feature flag mestre. DEVE começar como "false" em todo novo deploy.
# Ativar só após validar o contrato legado em produção e com aprovação
# explícita para o primeiro evento piloto.
LABEL_DYNAMIC_LAYOUT_ENABLED=false

# Lista de event_id (separados por vírgula) autorizados a usar o motor
# dinâmico durante o rollout controlado. Vazio = qualquer evento com
# layout publicado (só use lista vazia depois de validar o piloto).
LABEL_DYNAMIC_EVENT_IDS=

# Segredo Bearer exigido pela rota autenticada POST /v2/badges/render
LABEL_API_KEY=

# Allowlist de hosts (separados por vírgula) permitidos para buscar a
# logo do evento (event.label_logo). Se vazio, usa apenas o host do
# Storage do próprio SUPABASE_URL.
LABEL_LOGO_ALLOWED_HOSTS=

# TTL (segundos) do cache em memória de layout publicado (event_id -> layout)
LABEL_LAYOUT_CACHE_TTL_SECONDS=60

# TTL (segundos) do cache em memória de contexto (participant_id -> event_id)
LABEL_CONTEXT_CACHE_TTL_SECONDS=60

# Rate limit (por IP) e limite de concorrência (global), configuráveis por
# ambiente. Ver docs/plano-motor-dinamico-etiquetas.md §3.9 para os
# defaults recomendados por NODE_ENV (development/staging/production).
LABEL_RATE_LIMIT_WINDOW_MS=60000
LABEL_RATE_LIMIT_MAX=
LABEL_CONCURRENCY_LIMIT=

# Ambiente lógico usado para escolher os defaults de rate limit/concorrência
# quando as variáveis acima não forem definidas explicitamente.
NODE_ENV=development
